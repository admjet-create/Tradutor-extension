{
  "manifest_version": 3,
  "name": "Tradutor para Slack",
  "version": "0.1.0",
  "description": "Traduz mensagens do Slack entre inglês e português (áudio, música e backstage) usando o Claude.",
  "permissions": ["storage"],
  "host_permissions": ["https://api.anthropic.com/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://app.slack.com/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "options_page": "options.html",
  "action": {
    "default_title": "Tradutor para Slack"
  }
}
